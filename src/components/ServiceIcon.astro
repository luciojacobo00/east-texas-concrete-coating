  forklift: '<path d="M3 17V8h6l3 5v4"/><path d="M12 17h3"/><circle cx="6" cy="18.5" r="1.8"/><circle cx="14" cy="18.5" r="1.8"/><path d="M16 4v13"/><path d="M16 17h5"/><path d="M4 11h4"/>',
  sun: '<circle cx="12" cy="10" r="3.5"/><path d="M12 2v2M4.9 4.9l1.4 1.4M2 10h2M20 10h2M17.7 6.3l1.4-1.4"/><path d="M3 18h18M5 21h14"/>',
  storefront: '<path d="M3 9 5 4h14l2 5"/><path d="M3 9a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0"/><path d="M5 12v8h14v-8"/><path d="M10 20v-5h4v5"/>',
  grinder: '<circle cx="9" cy="14" r="5"/><circle cx="9" cy="14" r="1.5"/><path d="M13.5 11.5 20 5"/><path d="M17 3l4 4"/><path d="M3 21h12"/>',
  roller: '<rect x="3" y="4" width="13" height="6" rx="1.5"/><path d="M16 7h3v5H12v3"/><rect x="10.5" y="15" width="3" height="6" rx="1"/>',
  shield: '<path d="M12 3 4 6v6c0 4.5 3.4 7.6 8 9 4.6-1.4 8-4.5 8-9V6z"/><path d="m9 12 2 2 4-4"/>',
  droplet: '<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/><path d="M9.5 14a2.5 2.5 0 0 0 2.5 2.5"/>',
