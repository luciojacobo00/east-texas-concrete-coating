---
import { site, navHref } from '../lib/config';
const path = Astro.url.pathname;
import SiteImage from './SiteImage.astro';
import QuoteForm from './QuoteForm.astro';
const { hero } = site;
const banner = hero.layout === 'banner';
const blur = Math.max(0, hero.imageBlur ?? 0);
const contain = hero.imageFit === 'contain';
const backdropOnly = banner && hero.hideImage === true;
const positionStyle = [
  hero.imagePosition ? `--hero-position: ${hero.imagePosition}` : '',
  blur ? `--hero-blur: ${blur}px` : '',
].filter(Boolean).join('; ') || undefined;
---

{banner ? (
  <section class:list={['hero', 'hero--banner', { 'hero--backdrop-only': backdropOnly }]}>
    {/* The same graphic, blurred and darkened, fills the section behind the sharp banner and the headline. */}
    <div class="hero__backdrop" aria-hidden="true" style={positionStyle}>
      <SiteImage src={hero.image} alt="" loading="eager" sizes="100vw" widths={[800, 1200]} />
    </div>
    {/* A branded graphic with its own text is shown whole, not as a backdrop for the headline. */}
    {!backdropOnly && (
      <div class:list={['banner', { 'banner--contain': contain }]} style={positionStyle}>
        <SiteImage src={hero.image} alt={`${site.company.name} banner`} loading="eager" sizes="100vw" widths={[800, 1200, 1600, 2400]} />
      </div>
    )}
    <div class="container hero__inner hero__inner--banner">
      <div class="hero__content">
        {hero.eyebrow && <span class="eyebrow">{hero.eyebrow}</span>}
        <h1>{hero.heading}</h1>
        <p class="hero__sub">{hero.subheading}</p>
        <div class="hero__actions">
          <a href={navHref(hero.primaryCta.href, path)} class="btn btn--primary">{hero.primaryCta.label}</a>
          {hero.secondaryCta && <a href={navHref(hero.secondaryCta.href, path)} class="btn btn--ghost">{hero.secondaryCta.label}</a>}
        </div>
      </div>
      <div class="hero__aside">
        {hero.showForm && <QuoteForm compact idPrefix="hero" heading={hero.formHeading} />}
        {!hero.showForm && hero.highlights && hero.highlights.length > 0 && (
          <ul class="hero__highlights hero__highlights--stack">
            {hero.highlights.map((h) => (
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L20 7"/></svg>
                {h}
              </li>
            ))}
          </ul>
        )}
        {!hero.showForm && hero.stats && hero.stats.length > 0 && (
          <ul class="hero__stats hero__stats--aside">
            {hero.stats.map((s) => (
              <li>
                <strong>{s.value}</strong>
                <span>{s.label}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>
  </section>
) : (
  <section class="hero">
    <div class:list={['hero__media', { 'hero__media--blur': blur > 0 }]} aria-hidden="true" style={positionStyle}>
      <SiteImage src={hero.image} alt="" loading="eager" sizes="100vw" widths={[800, 1200, 1600, 2400]} />
    </div>

    <div class="container hero__inner">
      <div class="hero__content">
        {hero.eyebrow && <span class="eyebrow">{hero.eyebrow}</span>}
        <h1>{hero.heading}</h1>
        <p class="hero__sub">{hero.subheading}</p>
        <div class="hero__actions">
          <a href={navHref(hero.primaryCta.href, path)} class="btn btn--primary">{hero.primaryCta.label}</a>
          {hero.secondaryCta && <a href={navHref(hero.secondaryCta.href, path)} class="btn btn--ghost">{hero.secondaryCta.label}</a>}
        </div>
        {hero.highlights && hero.highlights.length > 0 && (
          <ul class="hero__highlights">
            {hero.highlights.map((h) => (
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L20 7"/></svg>
                {h}
              </li>
            ))}
          </ul>
        )}
      </div>

      {hero.stats && hero.stats.length > 0 && (
        <ul class="hero__stats">
          {hero.stats.map((s) => (
            <li>
              <strong>{s.value}</strong>
              <span>{s.label}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
)}

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .hero__media { position: absolute; inset: 0; z-index: -1; }
  .hero__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--hero-position, center);
  }
  /* A blurred backdrop is scaled up slightly so its soft edges stay outside the frame, and dimmed so text reads over it. */
  .hero__media--blur :global(img) {
    filter: blur(var(--hero-blur, 0px)) brightness(0.6) saturate(1.1);
    transform: scale(1.06);
  }
  /* Darkens the top for the header and the bottom-left for the headline, leaving the floor clear on the right. */
  .hero__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0) 25%),
      linear-gradient(to top, var(--color-bg) 0%, color-mix(in srgb, var(--color-bg) 75%, transparent) 28%, transparent 65%),
      linear-gradient(95deg, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.15) 55%, rgba(0, 0, 0, 0) 80%);
  }
  /* On phones the headline sits over more of the photo, so the bottom fade climbs higher. */
  @media (max-width: 640px) {
    .hero__media::after {
      background:
        linear-gradient(to bottom, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0) 25%),
        linear-gradient(to top, var(--color-bg) 0%, color-mix(in srgb, var(--color-bg) 85%, transparent) 45%, color-mix(in srgb, var(--color-bg) 40%, transparent) 75%, transparent 100%);
    }
  }
  .hero__inner {
    padding-top: calc(var(--header-height) + 4rem);
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .hero__content { max-width: 50rem; }
  .hero h1 { margin-bottom: 1.5rem; }
  .hero__sub {
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    max-width: 38rem;
    margin-bottom: 2.25rem;
    color: color-mix(in srgb, var(--color-text) 88%, transparent);
  }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.85rem; }
  .hero__highlights {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.75rem;
    font-size: 0.92rem;
    font-weight: 500;
  }
  .hero__highlights li { display: inline-flex; align-items: center; gap: 0.5rem; }
  .hero__highlights svg { color: var(--color-accent); flex: none; }
  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3.5rem;
    list-style: none;
    padding: 2rem 0 0;
    margin: clamp(2.5rem, 6vw, 4rem) 0 0;
    border-top: 1px solid var(--color-border);
  }
  .hero__stats li { display: flex; flex-direction: column; gap: 0.3rem; }
  .hero__stats strong {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.75rem;
    line-height: 1;
    color: var(--color-accent);
  }
  .hero__stats span {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* --- Banner layout --- */
  .hero--banner {
    min-height: 0;
    flex-direction: column;
    align-items: stretch;
  }
  .hero__backdrop { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
  .hero__backdrop :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--hero-position, center);
    filter: blur(18px) brightness(0.35) saturate(1.2);
    transform: scale(1.1);
  }
  .hero__backdrop::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 40%, color-mix(in srgb, var(--color-bg) 85%, transparent));
  }
  .banner {
    position: relative;
    width: 100%;
    max-height: 78svh;
    overflow: hidden;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }
  .banner :global(img) {
    width: 100%;
    height: auto;
    max-height: 78svh;
    object-fit: cover;
    object-position: var(--hero-position, center);
  }
  /* Uncropped graphic: centered in the container, scaled to fit, no shadow or clipping. */
  .banner--contain {
    width: min(100% - 2.5rem, 80rem);
    margin: clamp(1rem, 3vw, 2.5rem) auto 0;
    max-height: none;
    box-shadow: none;
  }
  .banner--contain :global(img) {
    max-height: 72svh;
    object-fit: contain;
    margin-inline: auto;
    width: auto;
    max-width: 100%;
    /* Matches the graphic's own rounded corners so its black corner pixels are clipped away. */
    border-radius: 5.8% / 14%;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
  }
  /* Backdrop only: the blurred graphic fills a tall section with the content centered in it. */
  .hero--backdrop-only { min-height: 82svh; justify-content: center; }
  .hero--backdrop-only .hero__backdrop :global(img) { filter: blur(14px) brightness(0.45) saturate(1.15); }
  .hero--backdrop-only .hero__backdrop::after {
    background:
      linear-gradient(to bottom, rgba(0, 0, 0, 0.5) 0%, transparent 30%),
      linear-gradient(to bottom, transparent 55%, color-mix(in srgb, var(--color-bg) 90%, transparent));
  }
  .hero--backdrop-only .hero__inner--banner { padding-top: clamp(4rem, 8vw, 7rem); padding-bottom: clamp(4rem, 8vw, 7rem); align-items: center; }
  .hero__inner--banner:has(.quote-form) { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); }
  .hero__inner--banner {
    padding-top: clamp(3rem, 6vw, 5rem);
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
  }
  .hero--banner h1 { font-size: clamp(2.75rem, 6.5vw, 5.25rem); }
  .hero__aside { display: grid; gap: 2rem; }
  .hero__highlights--stack {
    margin: 0;
    flex-direction: column;
    gap: 0.9rem;
    font-size: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--color-surface) 80%, transparent);
    backdrop-filter: blur(8px);
  }
  .hero__stats--aside { margin: 0; padding: 0; border: 0; gap: 1.25rem 2.5rem; }
  @media (max-width: 900px) {
    .hero__inner--banner,
    .hero__inner--banner:has(.quote-form) { grid-template-columns: minmax(0, 1fr); align-items: start; }
  }
</style>
