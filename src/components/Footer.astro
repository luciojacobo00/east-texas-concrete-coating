---
import { site, fullAddress, telHref, telFor, mailHref, navHref, isExternal } from '../lib/config';
import Logo from './Logo.astro';
import SocialIcon from './SocialIcon.astro';
const year = new Date().getFullYear();
const path = Astro.url.pathname;
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <Logo />
      <p>{site.company.description}</p>
      {site.social.length > 0 && (
        <ul class="social">
          {site.social.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener" aria-label={s.label}>
                <SocialIcon platform={s.platform} />
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <div>
      <h4>Explore</h4>
      <ul class="footer__links">
        {site.nav.map((l) => <li><a href={navHref(l.href, path)}>{l.label}</a></li>)}
        {site.footer.links.map((l) => (
          <li>
            <a href={l.href} target={isExternal(l.href) ? '_blank' : undefined} rel={isExternal(l.href) ? 'noopener' : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h4>Contact</h4>
      <ul class="footer__links">
        <li><a href={telHref()}>{site.contact.phone}</a></li>
        {site.contact.altPhone && <li><a href={telFor(site.contact.altPhone)}>{site.contact.altPhone}</a></li>}
        <li><a href={mailHref()}>{site.contact.email}</a></li>
        <li>{fullAddress()}</li>
      </ul>
    </div>

    <div>
      <h4>Hours</h4>
      <ul class="footer__links">
        {site.contact.hours.map((h) => <li>{h.days}<br /><span class="footer__muted">{h.time}</span></li>)}
      </ul>
    </div>
  </div>

  <div class="container footer__bottom">
    <span>© {year} {site.company.name}. All rights reserved.</span>
    <span>{site.footer.text}</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    padding-top: clamp(3rem, 7vw, 5rem);
    font-size: 0.95rem;
  }
  .footer__grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 2fr repeat(3, 1fr);
    padding-bottom: 3rem;
  }
  .footer__brand p { margin-top: 1.25rem; max-width: 24rem; }
  h4 {
    font-family: var(--font-body);
    color: var(--color-text);
    margin-bottom: 1.25rem;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }
  .footer__links { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .footer__links a { color: inherit; text-decoration: none; transition: color 0.2s; }
  .footer__links a:hover { color: var(--color-accent); }
  .footer__muted { opacity: 0.7; }
  .social { list-style: none; margin: 1.5rem 0 0; padding: 0; display: flex; gap: 0.6rem; }
  .social a {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .social a:hover { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-on-accent); }
  .footer__bottom {
    border-top: 1px solid var(--color-border);
    padding-block: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    font-size: 0.82rem;
  }
  @media (max-width: 900px) { .footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .footer__grid { grid-template-columns: 1fr; } }
</style>
