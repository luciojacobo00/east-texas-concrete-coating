  facebook: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>',
  youtube: '<path d="M22 8s-.2-1.6-.8-2.3c-.8-.8-1.6-.8-2-.9C16.4 4.6 12 4.6 12 4.6s-4.4 0-7.2.2c-.4.1-1.2.1-2 .9C2.2 6.4 2 8 2 8s-.2 1.9-.2 3.7v1.7c0 1.9.2 3.7.2 3.7s.2 1.6.8 2.3c.8.8 1.8.8 2.2.9 1.6.2 7 .2 7 .2s4.4 0 7.2-.2c.4-.1 1.2-.1 2-.9.6-.7.8-2.3.8-2.3s.2-1.9.2-3.7v-1.7C22.2 9.9 22 8 22 8z"/><path d="M10 15l5-3-5-3z" fill="currentColor"/>',
  tiktok: '<path d="M14 3v12.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.3 2.8 2.2 4.7 5 5"/>',
  google: '<circle cx="12" cy="12" r="9"/><path d="M12 12h6"/><path d="M18 12a6 6 0 1 1-1.8-4.3"/>',
  yelp: '<path d="M12 3v8l-2 1"/><path d="m5 9 5 3"/><path d="m4.5 16 5-2"/><path d="m10 21 2-6"/><path d="m19 16.5-5-2"/><path d="m19.5 9.5-5 2.5"/>',
  linkedin: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M8 10v7M8 7v.5M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"/>',
  x: '<path d="M4 4l16 16M20 4L4 20"/>',
  default: '<circle cx="12" cy="12" r="9"/>',
};
const path = icons[platform] ?? icons.default;
---

<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={path} />
