---
import { site, fullAddress, telHref, telFor, mailHref, mapsHref } from '../lib/config';
import SocialIcon from './SocialIcon.astro';
import QuoteForm from './QuoteForm.astro';
const { contact, contactForm, company } = site;
---

<section id="contact" class="section section--alt">
  <div class="container contact">
    <div class="contact__info">
      <span class="eyebrow">{contactForm.eyebrow}</span>
      <h2>{contactForm.heading}</h2>
      <p class="contact__intro">{contactForm.intro}</p>
      {contact.bookingNote && <p class="contact__note">{contact.bookingNote}</p>}

      <dl class="contact__details">
        <div>
          <dt>Phone</dt>
          <dd>
            <a href={telHref()}>{contact.phone}</a>
            {contact.altPhone && <><br /><a href={telFor(contact.altPhone)}>{contact.altPhone}</a></>}
          </dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd><a href={mailHref()}>{contact.email}</a></dd>
        </div>
        <div>
          <dt>{contact.address.street ? 'Shop' : 'Based in'}</dt>
          <dd><a href={mapsHref()} target="_blank" rel="noopener">{fullAddress()}</a></dd>
        </div>
        {contact.hours.length > 0 && (
          <div>
            <dt>Hours</dt>
            <dd>
              <ul class="hours">
                {contact.hours.map((h) => (
                  <li><span>{h.days}</span><span>{h.time}</span></li>
                ))}
              </ul>
            </dd>
          </div>
        )}
      </dl>
      <p class="contact__area">{contact.serviceArea}</p>
      {company.license && <p class="contact__license">{company.license}</p>}

      {site.social.length > 0 && (
        <ul class="contact__social">
          {site.social.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener">
                <SocialIcon platform={s.platform} />
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <QuoteForm idPrefix="contact" />
  </div>
</section>

<style>
  .contact {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: start;
  }
  @media (max-width: 900px) { .contact { grid-template-columns: minmax(0, 1fr); } }

  .contact__intro { color: var(--color-muted); font-size: 1.1rem; max-width: 30rem; }
  .contact__note {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-accent);
    margin: 1.5rem 0 0;
  }
  .contact__details { margin: 2.5rem 0 1.5rem; display: grid; }
  .contact__details > div {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 0.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--color-border);
  }
  .contact__details > div:last-child { border-bottom: 1px solid var(--color-border); }
  dt {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
    padding-top: 0.25rem;
  }
  dd { margin: 0; }
  dd a { color: var(--color-text); text-decoration: none; }
  dd a:hover { color: var(--color-accent); }
  .hours { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.25rem; }
  .hours li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0 1rem; max-width: 22rem; }
  .hours li span:last-child { color: var(--color-muted); }
  @media (max-width: 520px) { .hours li { flex-direction: column; } }
  .contact__area, .contact__license { color: var(--color-muted); font-size: 0.95rem; }
  .contact__license { font-size: 0.85rem; }

  .contact__social { list-style: none; margin: 1.5rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; }
  .contact__social a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .contact__social a:hover { color: var(--color-accent); }

</style>

