---
// One route for every entry under `pages` in site.json: "full-flake" -> /full-flake
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteImage from '../components/SiteImage.astro';
import { site } from '../lib/config';
import type { ContentPage } from '../lib/config';

export function getStaticPaths() {
  return Object.entries(site.pages ?? {}).map(([slug, page]) => ({ params: { slug }, props: { page } }));
}

const { page } = Astro.props as { page: ContentPage };
---

<BaseLayout title={page.title} description={page.intro}>
  <article class="page">
    <header class="page__head">
      <div class="container page__head-inner">
        <div>
          {page.eyebrow && <span class="eyebrow">{page.eyebrow}</span>}
          <h1>{page.title}</h1>
          <p class="page__intro">{page.intro}</p>
          {page.cta && <a href={page.cta.href} class="btn btn--primary">{page.cta.label}</a>}
        </div>
        {page.image && (
          <div class="page__image">
            <SiteImage src={page.image} alt="" loading="eager" widths={[600, 1000]} sizes="(max-width: 900px) 100vw, 40vw" />
          </div>
        )}
      </div>
    </header>

    <div class="container page__body">
      <nav class="toc" aria-label="On this page">
        <span class="toc__label">On this page</span>
        <ol>
          {page.sections.map((s) => <li><a href={`#${s.id}`}>{s.heading}</a></li>)}
        </ol>
        {page.cta && <a href={page.cta.href} class="btn btn--primary toc__cta">{page.cta.label}</a>}
      </nav>

      <div class="sections">
        {page.sections.map((s) => (
          <section id={s.id} class="block">
            <h2>{s.heading}</h2>
            {s.body?.map((p) => <p>{p}</p>)}
            {s.bullets && s.bullets.length > 0 && (
              <ul class="bullets">
                {s.bullets.map((b) => <li>{b}</li>)}
              </ul>
            )}
            {s.steps && s.steps.length > 0 && (
              <ol class="steps">
                {s.steps.map((st) => (
                  <li>
                    <strong>{st.title}</strong>
                    <span>{st.text}</span>
                  </li>
                ))}
              </ol>
            )}
          </section>
        ))}

        {page.cta && (
          <div class="page__cta">
            <h2>{page.ctaHeading ?? 'Ready to get started?'}</h2>
            {page.ctaText && <p>{page.ctaText}</p>}
            <a href={page.cta.href} class="btn btn--primary">{page.cta.label}</a>
          </div>
        )}
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .page__head {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }
  .page__head-inner {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  @media (max-width: 900px) { .page__head-inner { grid-template-columns: minmax(0, 1fr); } }
  .page__head h1 { font-size: clamp(2.75rem, 6vw, 4.75rem); margin-bottom: 1.25rem; }
  .page__intro { color: var(--color-muted); font-size: 1.15rem; max-width: 36rem; margin-bottom: 2rem; }
  /* The header image keeps its own proportions so charts and labels are never cropped. */
  .page__image {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: #fff;
  }
  .page__image :global(img) { width: 100%; height: auto; display: block; }

  .page__body {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    padding-block: clamp(3rem, 6vw, 5rem);
  }
  @media (max-width: 900px) { .page__body { grid-template-columns: minmax(0, 1fr); } }

  .toc { position: sticky; top: calc(var(--header-height) + 1.5rem); align-self: start; }
  @media (max-width: 900px) { .toc { position: static; } }
  .toc__label {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.75rem;
  }
  .toc ol { list-style: none; margin: 0; padding: 0; display: grid; }
  .toc a {
    display: block;
    padding: 0.6rem 0 0.6rem 1rem;
    border-left: 2px solid var(--color-border);
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s, border-color 0.2s;
  }
  .toc a:hover { color: var(--color-accent); border-left-color: var(--color-accent); }
  .toc__cta { margin-top: 1.5rem; width: 100%; }

  .sections { max-width: 46rem; }
  .block { padding-bottom: clamp(2.5rem, 5vw, 4rem); margin-bottom: clamp(2.5rem, 5vw, 4rem); border-bottom: 1px solid var(--color-border); }
  .block h2 { font-size: clamp(1.9rem, 3.5vw, 2.6rem); margin-bottom: 1rem; }
  .block p { color: var(--color-muted); font-size: 1.05rem; }
  .bullets { margin: 1.25rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.6rem; }
  .bullets li { display: flex; gap: 0.75rem; align-items: baseline; }
  .bullets li::before {
    content: "";
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--color-accent);
    transform: translateY(-0.05em) rotate(45deg);
  }
  .steps { margin: 1.5rem 0 0; padding: 0; list-style: none; counter-reset: step; display: grid; gap: 1rem; }
  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.25rem 1rem;
    padding: 1.1rem 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .steps li::before {
    content: counter(step, decimal-leading-zero);
    grid-row: span 2;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-accent);
  }
  .steps strong { font-family: var(--font-display); font-size: 1.2rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.02em; }
  .steps span { color: var(--color-muted); }

  .page__cta {
    padding: clamp(1.75rem, 4vw, 2.75rem);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius);
  }
  .page__cta h2 { font-size: clamp(1.75rem, 3vw, 2.4rem); }
  .page__cta p { color: var(--color-muted); margin-bottom: 1.5rem; }
</style>
